{
  "manifest_version": 1,
  "host_api": "1",
  "id": "org.wordflowlab.story-research",
  "version": "0.1.0",
  "display": {
    "zh-CN": "创作研究台",
    "en": "Story Research"
  },
  "description": {
    "zh-CN": "把灵感、考据和公开观察整理为有据、可争论、可供规划引用的研究成果。",
    "en": "Story Research with fixed evidence and external Agent workflows."
  },
  "license": "Apache-2.0",
  "dependencies": [],
  "work_kinds": [
    "novel"
  ],
  "runtime": {
    "entry": "backend.mjs"
  },
  "contributions": {
    "views": [
      {
        "id": "main",
        "title": "创作研究台",
        "entry": "index.html",
        "object_kinds": [
          "story_research"
        ],
        "navigation": "integrated"
      }
    ],
    "data": [
      {
        "kind": "story_research",
        "schema_version": "1.0.0",
        "schema": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "format_version": {
              "const": 1
            },
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "questions": {
              "type": "array",
              "maxItems": 200,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  },
                  "title": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  "purpose": {
                    "type": "string",
                    "enum": [
                      "inspiration",
                      "market",
                      "fact"
                    ]
                  },
                  "status": {
                    "type": "string",
                    "enum": [
                      "open",
                      "in_progress",
                      "answered",
                      "inconclusive"
                    ]
                  }
                },
                "required": [
                  "id",
                  "title",
                  "purpose",
                  "status"
                ]
              }
            },
            "observations": {
              "type": "array",
              "maxItems": 500,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  },
                  "question_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  },
                  "title": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  "kind": {
                    "type": "string",
                    "enum": [
                      "quotation",
                      "observation",
                      "inference",
                      "counterexample"
                    ]
                  },
                  "statement": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 8000
                  },
                  "polarity": {
                    "type": "string",
                    "enum": [
                      "supports",
                      "contradicts",
                      "context"
                    ]
                  },
                  "source_role": {
                    "type": "string",
                    "enum": [
                      "primary",
                      "secondary",
                      "author_note",
                      "unknown"
                    ]
                  },
                  "observed_on": {
                    "type": "string",
                    "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                  },
                  "evidence": {
                    "type": "array",
                    "maxItems": 50,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "source_index": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 99
                        },
                        "byte_start": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 100000000
                        },
                        "byte_end": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 100000000
                        },
                        "quote": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 16000
                        }
                      },
                      "required": [
                        "source_index",
                        "byte_start",
                        "byte_end",
                        "quote"
                      ]
                    }
                  }
                },
                "required": [
                  "id",
                  "question_id",
                  "title",
                  "kind",
                  "statement",
                  "polarity",
                  "source_role",
                  "observed_on",
                  "evidence"
                ]
              }
            },
            "conclusions": {
              "type": "array",
              "maxItems": 200,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  },
                  "question_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  },
                  "title": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  "summary": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 8000
                  },
                  "status": {
                    "type": "string",
                    "enum": [
                      "proposed",
                      "supported",
                      "contested",
                      "inconclusive"
                    ]
                  },
                  "observation_ids": {
                    "type": "array",
                    "maxItems": 100,
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 100
                    }
                  },
                  "limitations": {
                    "type": "array",
                    "maxItems": 30,
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 2000
                    }
                  }
                },
                "required": [
                  "id",
                  "question_id",
                  "title",
                  "summary",
                  "status",
                  "observation_ids",
                  "limitations"
                ]
              }
            },
            "basis_refs": {
              "type": "array",
              "maxItems": 20,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "owner_plugin_id": {
                    "type": "string",
                    "maxLength": 120,
                    "pattern": "^[a-z0-9-]+(?:\\.[a-z0-9-]+)+$"
                  },
                  "object_id": {
                    "type": "string",
                    "pattern": "^ext_[a-f0-9-]{36}$"
                  },
                  "revision": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 9007199254740991
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  }
                },
                "required": [
                  "owner_plugin_id",
                  "object_id",
                  "revision",
                  "sha256"
                ]
              }
            }
          },
          "required": [
            "format_version",
            "title",
            "questions",
            "observations",
            "conclusions",
            "basis_refs"
          ]
        }
      }
